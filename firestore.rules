  rules_version = '2';

  service cloud.firestore {
    match /databases/{database}/documents {

      // ============================================================
      // AUTHENTICATION AND AUTHORIZATION HELPERS
      // ============================================================

      function signedIn() {
        return request.auth != null;
      }

      function isMe(uid) {
        return signedIn() && request.auth.uid == uid;
      }

      function hasEmail() {
        return signedIn()
          && request.auth.token.email is string;
      }

      // Admin access requires a trusted Firebase custom claim.
      function isAdmin() {
        return signedIn()
          && request.auth.token.admin == true;
      }

      function isPetOwner(pet) {
        return signedIn()
          && pet.ownerIds is list
          && request.auth.uid in pet.ownerIds;
      }

      function isPrimaryOwner(pet) {
        return signedIn()
          && pet.primaryOwnerId == request.auth.uid;
      }

      // ============================================================
      // INVITATION HELPERS
      // ============================================================

      function jointInvitationPath(petId) {
        return /databases/$(database)/documents/jointInvitations/$(petId + '__' + request.auth.token.email);
      }

      function ownerInvitationPath(petId) {
        return /databases/$(database)/documents/owner_invitations/$(petId + '__' + request.auth.token.email);
      }

      function validJointAcceptance(petId) {
        return hasEmail()
          && exists(jointInvitationPath(petId))
          && existsAfter(jointInvitationPath(petId))
          && get(jointInvitationPath(petId)).data.status == 'pending'
          && get(jointInvitationPath(petId)).data.petId == petId
          && get(jointInvitationPath(petId)).data.invitedEmail == request.auth.token.email
          && getAfter(jointInvitationPath(petId)).data.status == 'accepted'
          && getAfter(jointInvitationPath(petId)).data.acceptedBy == request.auth.uid;
      }

      function validOwnerAcceptance(petId) {
        return hasEmail()
          && exists(ownerInvitationPath(petId))
          && existsAfter(ownerInvitationPath(petId))
          && get(ownerInvitationPath(petId)).data.status == 'pending'
          && get(ownerInvitationPath(petId)).data.petId == petId
          && get(ownerInvitationPath(petId)).data.invitedEmail == request.auth.token.email
          && getAfter(ownerInvitationPath(petId)).data.status == 'accepted'
          && getAfter(ownerInvitationPath(petId)).data.acceptedBy == request.auth.uid;
      }

      function validPetAcceptance(petId) {
        return (validJointAcceptance(petId)
            || validOwnerAcceptance(petId))
          && resource.data.ownerIds is list
          && request.resource.data.ownerIds is list
          && !(request.auth.uid in resource.data.ownerIds)
          && request.auth.uid in request.resource.data.ownerIds
          && request.resource.data.ownerIds.hasAll(resource.data.ownerIds)
          && request.resource.data.ownerIds.size()
              == resource.data.ownerIds.size() + 1
          && request.resource.data.primaryOwnerId
              == resource.data.primaryOwnerId
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['ownerIds', 'updatedAt']);
      }

      function validPetRemovalOfCoOwner() {
        return isPrimaryOwner(resource.data)
          && resource.data.ownerIds is list
          && request.resource.data.ownerIds is list
          && resource.data.ownerIds.hasAll(request.resource.data.ownerIds)
          && request.resource.data.ownerIds.hasAny([request.auth.uid])
          && request.resource.data.ownerIds.size()
              < resource.data.ownerIds.size()
          && request.resource.data.primaryOwnerId
              == resource.data.primaryOwnerId
          && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['ownerIds', 'updatedAt']);
      }

      // ============================================================
      // PUBLIC PET PROFILE VALIDATION
      // Public fields must match the corresponding private pet.
      // Includes photoUrls for the multiple-photo gallery.
      // ============================================================

      function publicPetMatchesPrivate(petId) {
        let petPath =
          /databases/$(database)/documents/pets/$(petId);

        return existsAfter(petPath)
          && isPetOwner(getAfter(petPath).data)
          && getAfter(petPath).data.get('petId', '') == request.resource.data.petId
          && getAfter(petPath).data.get('petName', '') == request.resource.data.petName
          && getAfter(petPath).data.get('breed', '') == request.resource.data.breed
          && getAfter(petPath).data.get('color', '') == request.resource.data.color
          && getAfter(petPath).data.get('age', '') == request.resource.data.age
          && getAfter(petPath).data.get('photoUrl', '') == request.resource.data.photoUrl
          && getAfter(petPath).data.get('photoUrls', [])
              == request.resource.data.get('photoUrls', [])
          && getAfter(petPath).data.get('status', '') == request.resource.data.status
          && getAfter(petPath).data.get('qrEnabled', false) == request.resource.data.qrEnabled
          && getAfter(petPath).data.get('sex', '') == request.resource.data.sex
          && getAfter(petPath).data.get('identifyingMarks', '') == request.resource.data.identifyingMarks;
      }

      // ============================================================
      // USER PROFILES
      // ============================================================

      match /users/{uid} {
        allow read, create, update, delete: if isMe(uid);
      }

      // ============================================================
      // OWNER PROFILES
      // ============================================================

      match /owners/{uid} {
        allow read: if isMe(uid);

        allow create: if isMe(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role in ['owner', 'co-owner'];

        allow update: if isMe(uid)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.role in ['owner', 'co-owner']
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'name', 'email', 'contact', 'role',
                'updatedAt', 'createdAt', 'userId'
              ]);

        allow delete: if false;
      }

      // ============================================================
      // PRIVATE PET DOCUMENTS
      // ============================================================

      match /pets/{petId} {
        allow get: if signedIn()
          && (
            isPetOwner(resource.data)
            || isPrimaryOwner(resource.data)
          );
      // Collection queries must be constrained to documents
      // owned by the signed-in user.
      allow list: if signedIn()
        && resource.data.ownerIds is list
        && request.auth.uid in resource.data.ownerIds;

        allow create: if signedIn()
          && request.resource.data.petId == petId
          && request.resource.data.primaryOwnerId == request.auth.uid
          && request.resource.data.ownerIds == [request.auth.uid]
          && request.resource.data.keys().hasOnly([
            'petId', 'petName', 'breed', 'color', 'age',
            'identifyingMarks', 'sex', 'photoUrl', 'photoUrls',
            'ownerIds', 'primaryOwnerId', 'ownerName',
            'ownerContact', 'status', 'safetyTag', 'qrEnabled',
            'createdAt', 'updatedAt'
          ]);

        // Normal pet edits cannot directly modify ownerIds
        // or primaryOwnerId.
        allow update: if (
            isPetOwner(resource.data)
            && request.resource.data.diff(resource.data)
                .affectedKeys().hasOnly([
                  'petName', 'breed', 'color', 'age',
                  'identifyingMarks', 'sex', 'photoUrl',
                  'photoUrls', 'ownerName', 'ownerContact',
                  'status', 'safetyTag', 'qrEnabled', 'updatedAt'
                ])
          )
          || validPetAcceptance(petId)
          || validPetRemovalOfCoOwner();

        // Only the primary owner may delete the pet.
        allow delete: if isPrimaryOwner(resource.data);
      }

      // ============================================================
      // PUBLIC QR PET PROFILES
      // ============================================================

      match /public_pets/{petId} {
        // Anyone may read enabled public QR profiles.
        allow read: if resource.data.qrEnabled == true;

        allow create, update: if signedIn()
          && request.resource.data.petId == petId
          && request.resource.data.keys().hasOnly([
            'petId', 'petName', 'breed', 'color', 'age',
            'sex', 'identifyingMarks', 'photoUrl', 'photoUrls',
            'status', 'qrEnabled', 'updatedAt'
          ])
          && request.resource.data.sex is string
          && request.resource.data.identifyingMarks is string
          && publicPetMatchesPrivate(petId);

        // Preserve the primary-owner deletion flow.
        allow delete: if signedIn()
          && exists(
            /databases/$(database)/documents/pets/$(petId)
          )
          && isPrimaryOwner(
            get(
              /databases/$(database)/documents/pets/$(petId)
            ).data
          )
          && !existsAfter(
            /databases/$(database)/documents/pets/$(petId)
          );
      }

      // ============================================================
      // JOINT OWNER INVITATIONS
      // ============================================================

      match /jointInvitations/{invitationId} {
        allow get, list: if signedIn()
          && (
            resource.data.invitedBy == request.auth.uid
            || (
              hasEmail()
              && resource.data.invitedEmail == request.auth.token.email
            )
          );

        allow create: if signedIn()
          && request.resource.data.invitationId == invitationId
          && invitationId
              == request.resource.data.petId + '__'
                  + request.resource.data.invitedEmail
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'invitationId', 'petId', 'petName',
            'invitedBy', 'invitedEmail', 'status',
            'createdAt', 'expiresAt'
          ])
          && exists(
            /databases/$(database)/documents/pets/$(request.resource.data.petId)
          )
          && isPrimaryOwner(
            get(
              /databases/$(database)/documents/pets/$(request.resource.data.petId)
            ).data
          );

        allow update: if signedIn()
          && resource.data.status == 'pending'
          && (
            // Recipient accepts.
            (
              hasEmail()
              && resource.data.invitedEmail == request.auth.token.email
              && request.resource.data.status == 'accepted'
              && request.resource.data.acceptedBy == request.auth.uid
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status', 'acceptedBy', 'acceptedAt', 'updatedAt'
                  ])
              && existsAfter(
                /databases/$(database)/documents/pets/$(resource.data.petId)
              )
              && request.auth.uid in getAfter(
                /databases/$(database)/documents/pets/$(resource.data.petId)
              ).data.ownerIds
            )
            ||
            // Recipient declines.
            (
              hasEmail()
              && resource.data.invitedEmail == request.auth.token.email
              && request.resource.data.status == 'declined'
              && request.resource.data.declinedBy == request.auth.uid
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status', 'declinedBy', 'declinedAt', 'updatedAt'
                  ])
            )
            ||
            // Sender cancels.
            (
              resource.data.invitedBy == request.auth.uid
              && request.resource.data.status == 'cancelled'
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly(['status', 'cancelledAt', 'updatedAt'])
            )
          );

        allow delete: if false;
      }

      // ============================================================
      // OWNER INVITATIONS
      // ============================================================

      match /owner_invitations/{invitationId} {
        allow get, list: if signedIn()
          && (
            resource.data.invitedBy == request.auth.uid
            || (
              hasEmail()
              && resource.data.invitedEmail == request.auth.token.email
            )
          );

        allow create: if signedIn()
          && request.resource.data.invitationId == invitationId
          && invitationId
              == request.resource.data.petId + '__'
                  + request.resource.data.invitedEmail
          && request.resource.data.invitedBy == request.auth.uid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly([
            'invitationId', 'petId', 'invitedEmail',
            'invitedBy', 'status', 'createdAt', 'updatedAt'
          ])
          && exists(
            /databases/$(database)/documents/pets/$(request.resource.data.petId)
          )
          && isPrimaryOwner(
            get(
              /databases/$(database)/documents/pets/$(request.resource.data.petId)
            ).data
          );

        allow update: if signedIn()
          && resource.data.status == 'pending'
          && (
            // Recipient accepts.
            (
              hasEmail()
              && resource.data.invitedEmail == request.auth.token.email
              && request.resource.data.status == 'accepted'
              && request.resource.data.acceptedBy == request.auth.uid
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status', 'acceptedBy', 'acceptedAt', 'updatedAt'
                  ])
              && existsAfter(
                /databases/$(database)/documents/pets/$(resource.data.petId)
              )
              && request.auth.uid in getAfter(
                /databases/$(database)/documents/pets/$(resource.data.petId)
              ).data.ownerIds
            )
            ||
            // Recipient rejects.
            (
              hasEmail()
              && resource.data.invitedEmail == request.auth.token.email
              && request.resource.data.status == 'rejected'
              && request.resource.data.rejectedBy == request.auth.uid
              && request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasOnly([
                    'status', 'rejectedBy', 'rejectedAt', 'updatedAt'
                  ])
            )
          );

        allow delete: if false;
      }

      // ============================================================
      // REPORTS
      // Includes lost, found, sighting and stray reports.
      // ============================================================

      match /reports/{reportId} {
        // Reports are private to the submitting user.
        allow read: if signedIn()
          && resource.data.reportedBy == request.auth.uid;

        allow create: if request.resource.data.reportId == reportId
          && request.resource.data.status == 'active'
          && request.resource.data.keys().hasOnly([
            'reportId', 'type', 'petId', 'petName', 'title',
            'name', 'location', 'lastSeenLocation',
            'foundLocation', 'locationName', 'details',
            'foundDate', 'message', 'photoUrl',
            'reportedBy', 'reporterEmail', 'status',
            'latitude', 'longitude', 'createdAt', 'updatedAt'
          ])
          && (
            // Lost and sighting reports require authentication.
            (
              signedIn()
              && request.resource.data.type in ['lost', 'sighting']
              && request.resource.data.reportedBy == request.auth.uid
              && request.resource.data.reporterEmail
                  == request.auth.token.email
            )
            ||
            // Found and stray reports may be submitted by guests.
            (
              request.resource.data.type in ['found', 'stray']
              && (
                (
                  signedIn()
                  && request.resource.data.reportedBy == request.auth.uid
                  && request.resource.data.reporterEmail
                      == request.auth.token.email
                )
                ||
                (
                  !signedIn()
                  && request.resource.data.reportedBy == null
                  && request.resource.data.reporterEmail == null
                )
              )
            )
          );

        allow update: if signedIn()
          && resource.data.reportedBy == request.auth.uid
          && request.resource.data.reportedBy == resource.data.reportedBy
          && request.resource.data.reporterEmail == resource.data.reporterEmail
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'location', 'locationName', 'details',
                'latitude', 'longitude', 'status', 'updatedAt'
              ])
          && request.resource.data.status in ['active', 'resolved'];

        allow delete: if signedIn()
          && resource.data.reportedBy == request.auth.uid;
      }

      // ============================================================
      // FOUND-PET NOTIFICATIONS
      // ============================================================

      match /found_reports/{reportId} {
        // Public read retained for the existing found-pet flow.
        allow read: if true;

        allow create: if request.resource.data.keys().hasOnly([
            'petId', 'petName', 'location',
            'message', 'reportedAt', 'status'
          ])
          && request.resource.data.petId is string
          && request.resource.data.petName is string
          && request.resource.data.location is string
          && request.resource.data.message is string
          && request.resource.data.status == 'new';

        allow update, delete: if false;
      }

      // ============================================================
      // SUPPORT REQUESTS
      // ============================================================

      match /support_requests/{requestId} {
        allow create: if signedIn()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.status == 'open'
          && request.resource.data.keys().hasOnly([
            'requestId', 'userId', 'userEmail', 'category',
            'subject', 'message', 'status', 'adminReply',
            'createdAt', 'updatedAt'
          ]);

        allow read: if signedIn()
          && resource.data.userId == request.auth.uid;

        // Admins may change only the support status, reply and timestamp.
        allow update: if isAdmin()
          && request.resource.data.keys().hasOnly([
            'requestId', 'userId', 'userEmail', 'category',
            'subject', 'message', 'status', 'adminReply',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'adminReply', 'updatedAt']);

        allow delete: if false;
      }

      // ============================================================
      // BARANGAY CONTACT INFORMATION
      // Document ID: barangays/primary
      // ============================================================

      match /barangays/{barangayId} {
        // Public visitors can read active contact information.
        // Admins can also read inactive records.
        allow get, list: if isAdmin()
          || resource.data.isActive == true;

        allow create, update: if isAdmin()
          && barangayId == 'primary'
          && request.resource.data.keys().hasOnly([
            'barangayName',
            'municipality',
            'province',
            'phone',
            'email',
            'address',
            'officeHours',
            'isActive',
            'updatedAt'
          ])
          && request.resource.data.barangayName is string
          && request.resource.data.municipality is string
          && request.resource.data.province is string
          && request.resource.data.phone is string
          && request.resource.data.email is string
          && request.resource.data.address is string
          && request.resource.data.officeHours is string
          && request.resource.data.isActive is bool
          && request.resource.data.updatedAt is timestamp;

        allow delete: if false;
      }

      // ============================================================
      // DENY ALL OTHER COLLECTIONS BY DEFAULT
      // ============================================================
    }
  }